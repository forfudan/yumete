# Normalise line endings so a macOS/Windows switch never shows a whole-file
# diff on a machine with core.autocrlf=true.
* text=auto eol=lf

# Windows-native scripts keep CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch binaries
*.png binary
*.zip binary
# 靈明精華版 —— crates/yumete-ime/jinghua/, compiled 碼表
*.ytab binary
